from functools import partial
import importlib

from enaml.workbench.api import Extension
from enaml.workbench.core.api import Command

from psi.context import api as context_api
from psi.controller.api import ExperimentAction
from psi.core.enaml.api import ExperimentManifest


# Cache the context items. This ensures that the class instance IDs do not
# change if the factory function is called multiple times.
CONTEXT_ITEM_CACHE = {}


def configure_trial_manager(manifest, event):
    controller = event.workbench.get_plugin('psi.controller')
    module_path, class_name = manifest.manager_path.rsplit('.', 1)
    module = importlib.import_module(module_path)
    manager_class = getattr(module, class_name)
    # manager_kwargs is empty unless the paradigm sets it, so managers whose
    # constructor accepts only `prefix` keep working.
    controller.trial_manager = manager_class(controller, prefix=manifest.prefix,
                                             **manifest.manager_kwargs)
    # Needed to know which parameters `get_default_parameters` added.
    controller.trial_manager.manager_kwargs = manifest.manager_kwargs


def generate_context_items(manifest, workbench):
    # This assumes that the list of params have not changed.
    if manifest in CONTEXT_ITEM_CACHE:
        return CONTEXT_ITEM_CACHE[manifest]

    module_path, class_name = manifest.manager_path.rsplit('.', 1)
    module = importlib.import_module(module_path)
    manager_class = getattr(module, class_name)

    context_group_names = set()
    context_items = []
    prefix = manifest.prefix

    # Trial managers can tailor their parameters to the paradigm definition
    # via `get_default_parameters`. Continuous stim managers do not define it
    # (and their manager_kwargs are constructor arguments).
    get_default_parameters = getattr(manager_class, 'get_default_parameters', None)
    if get_default_parameters is not None:
        default_parameters = get_default_parameters(**manifest.manager_kwargs)
    else:
        default_parameters = manager_class.default_parameters

    for entry in default_parameters:
        entry = entry.copy()
        entry.setdefault('group_name', manager_class.default_group_name)
        context_group_names.add(prefix + entry['group_name'])
        klass_name = entry.pop('type', 'Parameter')
        klass = getattr(context_api, klass_name)
        entry['name'] = prefix + entry['name']
        entry['group_name'] = prefix + entry['group_name']
        item = klass(**entry)
        # See https://enaml.readthedocs.io/en/latest/api_ref/core/declarative.html
        item.initialize()
        context_items.append(item)

    group_labels = getattr(manifest, 'group_labels', {})
    for group_name in context_group_names:
        group = context_api.ContextGroup(name=group_name)
        if group_name in group_labels:
            group.label = group_labels[group_name]
        context_items.append(group)

    CONTEXT_ITEM_CACHE[manifest] = context_items

    return context_items


enamldef TrialManagerManifest(ExperimentManifest): manifest:

    id = manifest.manager_path
    attr manager_path

    #: Keyword arguments passed to the manager constructor and to
    #: `get_default_parameters`.
    attr manager_kwargs = {}

    #: Labels for the parameter groups (keyed by group name, including the
    #: prefix).
    attr group_labels = {}

    required = True

    #: Prefix to add to names that will be shown in GUI.
    attr prefix = ''

    Extension:
        id = manifest.id + '.behavior_commands'
        point = 'enaml.workbench.core.commands'
        Command:
            id = manifest.id + '.configure_manager'
            handler = partial(configure_trial_manager, manifest)

    Extension:
        id = manifest.id + '.events'
        point = 'psi.controller.actions'

        ExperimentAction:
            event = 'experiment_prepare'
            command = manifest.id + '.configure_manager'

    Extension:
        id = manifest.id + '.items'
        point = 'psi.context.items'
        factory = partial(generate_context_items, manifest, workbench)


def configure_stim_manager(manifest, event):
    # Find the manager class instance
    controller = event.workbench.get_plugin('psi.controller')
    module_path, class_name = manifest.manager_path.rsplit('.', 1)
    module = importlib.import_module(module_path)
    manager_class = getattr(module, class_name)

    # Initialize it and attach it to the controller
    manager_instance = manager_class(controller, prefix=manifest.prefix,
                                     **manifest.manager_kwargs)
    controller.stim_managers.append(manager_instance)


enamldef ContinuousStimManagerManifest(ExperimentManifest): manifest:

    id = manifest.manager_path

    #: Full path to the manager class
    attr manager_path

    #: Keyword arguments that can be used to customize the manager.
    attr manager_kwargs = {}

    required = True

    #: Prefix to add to names that will be shown in GUI.
    attr prefix = ''

    Extension:
        id = manifest.id + '.behavior_commands'
        point = 'enaml.workbench.core.commands'
        Command:
            id = manifest.id + '.configure_manager'
            handler = partial(configure_stim_manager, manifest)

    Extension:
        id = manifest.id + '.events'
        point = 'psi.controller.actions'

        ExperimentAction:
            event = 'experiment_prepare'
            command = manifest.id + '.configure_manager'

    Extension:
        id = manifest.id + '.items'
        point = 'psi.context.items'
        factory = partial(generate_context_items, manifest, workbench)
